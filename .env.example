# Synthetic data only. Copy to .env; never commit credentials.
MODE=demo
PORT=3000
PUBLIC_BASE_URL=https://your-public-host.example
TWILIO_AUTH_TOKEN=
# gather keeps the original voice flow; relay enables Twilio ConversationRelay.
# Accept Twilio's AI/ML terms in Console before enabling. No ElevenLabs API key.
# Relay limits: one active session; five minutes per call, enforced at Twilio too.
VOICE_TRANSPORT=gather
# Warm female US English (Rachel); the relay uses the v4 speech model.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional staff destination in E.164 format. Empty means explain and end the call.
STAFF_PHONE_NUMBER=
HOSPITAL_TIME_ZONE=America/New_York

# MODE=referrals: seeded availability and confirmed fictional booking.
# Requires az login and Cosmos data-plane Data Contributor. No search needed.
# Database: hospital-network-db; patients/clinics partitioned by /id;
# appointment_slots partitioned by /clinic_id. See README for slot seeding.
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/

# Optional natural-language routing in MODE=referrals; false keeps exact commands.
# Uses Azure login + Cognitive Services OpenAI User, not an API key.
REFERRAL_AI_ENABLED=false
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Remaining values are required only for MODE=cloud (original demo aggregate).
# All cloud resources must already exist.
COSMOS_KEY=
COSMOS_DATABASE=frontdesk-demo
COSMOS_CONTAINER=demo-state
ELASTICSEARCH_URL=https://your-elasticsearch.example:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=frontdesk-demo-faq
AZURE_OPENAI_API_KEY=
